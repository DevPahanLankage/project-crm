# Required in production: first-admin bootstrap values.
# ADMIN_INITIAL_PASSWORD must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Required in production: local Docker PostgreSQL database settings.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Required by Prisma. In Docker Compose, the app service receives these as:
# postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=
DIRECT_URL=

# Development-only: ignored when NODE_ENV=production.
DEV_MOCK_AUTH=

# Development/demo seed only: never enable for routine production use.
RESET_SEEDED_PASSWORDS=

# Optional platform-neutral Next.js telemetry control.
NEXT_TELEMETRY_DISABLED=

# Optional server-only safe timing logs. Set exactly to "true" to enable.
PERF_LOGS=
